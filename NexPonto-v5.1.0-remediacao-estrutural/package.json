{
    "name":  "nexponto",
    "version":  "5.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit",
                    "build:full":  "next build",
                    "build:finalize":  "next build --experimental-build-mode=generate",
                    "build:compile":  "next build --experimental-build-mode=compile",
                    "test":  "vitest run --configLoader runner",
                    "test:watch":  "vitest --configLoader runner",
                    "migrations:check":  "node scripts/verify-migrations.mjs",
                    "security:data":  "node scripts/check-sensitive-data.mjs",
                    "verify":  "npm run security:data \u0026\u0026 npm run migrations:check \u0026\u0026 npm run structure:check \u0026\u0026 npm run structure:v51 \u0026\u0026 npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run build",
                    "verify:production":  "npm run security:data \u0026\u0026 npm run migrations:check \u0026\u0026 npm run structure:check \u0026\u0026 npm run structure:v51 \u0026\u0026 npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run build",
                    "structure:check":  "node scripts/verify-v4-structure.mjs",
                    "structure:v51":  "node scripts/verify-v51-remediation.mjs",
                    "test:critical":  "vitest run src/lib/services/__tests__/hour-bank-v51.test.ts src/lib/services/__tests__/historical-journey-v51.test.ts src/lib/services/__tests__/session-attendance-v51.test.ts src/lib/services/__tests__/schedule-v51.test.ts src/lib/services/__tests__/professional-payroll-v51.test.ts --configLoader runner"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "2.55.0",
