                         "bcryptjs":  "3.0.2",
                         "clsx":  "2.1.1",
                         "date-fns":  "4.1.0",
                         "exceljs":  "4.4.0",
                         "lucide-react":  "0.468.0",
                         "next":  "15.5.21",
                         "pdfkit":  "^0.19.1",
                         "qrcode":  "^1.5.4",
                         "react":  "19.1.0",
                         "react-dom":  "19.1.0",
                         "sharp":  "0.35.0",
                         "zod":  "3.25.76"
                     },
    "devDependencies":  {
                            "@eslint/eslintrc":  "3.3.1",
                            "@types/node":  "24.1.0",
                            "@types/react":  "19.1.9",
                            "@types/react-dom":  "19.1.7",
                            "@types/qrcode":  "^1.5.5",
                            "autoprefixer":  "10.4.21",
                            "eslint":  "9.32.0",
                            "eslint-config-next":  "15.5.21",
                            "postcss":  "8.5.19",
                            "tailwindcss":  "3.4.17",
                            "typescript":  "5.9.2",
                            "vitest":  "^3.2.6"
                        },
    "overrides":  {
                      "brace-expansion@\u003c1.1.16":  "1.1.16",
                      "brace-expansion@\u003e=2.0.0 \u003c2.1.2":  "2.1.2",
                      "sharp":  "0.35.0",
                      "uuid":  "11.1.1",
                      "postcss":  "$postcss"
                  },
    "packageManager":  "pnpm@10.14.0",
    "engines":  {
                    "node":  "20.x",
