# Copie para .env (o install.sh faz isso e gera as senhas sozinho).

# Seu domínio. Crie 3 registros DNS tipo A apontando para o IP do VPS:
#   n8n.seudominio.com.br, api.seudominio.com.br, chat.seudominio.com.br
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
N8N_SUBDOMAIN=n8n
EVOLUTION_SUBDOMAIN=api
CHATWOOT_SUBDOMAIN=chat
TZ=America/Sao_Paulo

# Banco e cache (gerados automaticamente pelo install.sh)
POSTGRES_USER=assistente
POSTGRES_PASSWORD=troque-me
REDIS_PASSWORD=troque-me

# Segredos (gerados automaticamente pelo install.sh). Guarde o N8N_ENCRYPTION_KEY:
# sem ele as credenciais salvas no n8n não podem ser lidas.
N8N_ENCRYPTION_KEY=troque-me
EVOLUTION_API_KEY=troque-me
CHATWOOT_SECRET_KEY_BASE=troque-me

# Versões das imagens. Em produção, fixe versões testadas em vez de "latest".
N8N_IMAGE_TAG=latest
EVOLUTION_IMAGE_TAG=latest
CHATWOOT_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=pg17
REDIS_IMAGE_TAG=7-alpine
CADDY_IMAGE_TAG=2-alpine
