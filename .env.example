# Supabase — use um projeto separado para homologação antes de produção.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-apenas-no-servidor

# Configuração inicial temporária. Remova MASTER_SETUP_TOKEN após ativar a primeira empresa.
MASTER_ADMIN_EMAIL=proprietario@empresa.com
MASTER_ADMIN_NAME=Proprietário da empresa
MASTER_SETUP_TOKEN=gere-um-token-aleatorio-com-pelo-menos-32-caracteres
MASTER_TENANT_NAME=Empresa principal
MASTER_TENANT_SLUG=empresa-principal
MASTER_TENANT_TIMEZONE=America/Fortaleza

# Opcional: o mesmo e-mail recebe acesso ao portal da plataforma NexLabs.
# Em produção, prefira uma conta exclusiva, protegida por MFA.
PLATFORM_SUPERADMIN_EMAIL=

# Segredos de sessão e auditoria — gere valores aleatórios diferentes por ambiente.
TENANT_CONTEXT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
EMPLOYEE_SESSION_SECRET=gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres
AUDIT_HASH_SALT=gere-um-salt-aleatorio-com-pelo-menos-32-caracteres
RATE_LIMIT_HASH_SALT=gere-um-salt-exclusivo-com-pelo-menos-32-caracteres
INTERNAL_JOBS_SECRET=gere-um-token-aleatorio-para-jobs-internos
DEVICE_IDENTITY_SECRET=gere-um-segredo-exclusivo-com-pelo-menos-32-caracteres
RECEIPT_TOKEN_SECRET=gere-um-segredo-exclusivo-com-pelo-menos-32-caracteres
JOB_WORKER_ID=nexponto-worker-01

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=5.3.1-remediated
DEFAULT_TIMEZONE=America/Fortaleza

# Opcional: mapas no cadastro e validação presencial das filiais.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Integrações externas opcionais, configuradas somente quando homologadas.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SENTRY_DSN=
OBSERVABILITY_DSN=
OBSERVABILITY_ENVIRONMENT=local
MALWARE_SCANNER_MODE=external_required

# Opcional para testes de migrations/RLS em PostgreSQL efêmero.
DATABASE_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_TENANT_A_EMAIL=
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_ID=
TEST_STORAGE_JUSTIFICATION_PATH_A=
TEST_STORAGE_JUSTIFICATION_PATH_B=
PRODUCTION_SECURITY_GATES=false

# Storage temporário de exportações profissionais.
REPORT_EXPORT_BUCKET=payroll-exports
EXPORTS_BUCKET=exports
REPORT_EXPORT_TTL_HOURS=24
BACKUP_RESTORE_EVIDENCE_URL=

# Feature flags. A folha oficial permanece desativada até homologação formal.
FEATURE_TIME_CLOCK=true
FEATURE_PRE_PAYROLL=true
FEATURE_OFFICIAL_PAYROLL=false
FEATURE_ACCOUNTING_EXPORT=false
FEATURE_ESOCIAL=false

# MFA desativado para administradores e administração Master.
MFA_ENFORCEMENT_ENABLED=false
NEXT_PUBLIC_MFA_ENFORCEMENT_ENABLED=false
