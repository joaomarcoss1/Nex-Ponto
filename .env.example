# Copie este arquivo para .env.local (dev) e configure as variáveis reais em
# produção diretamente no provedor de hospedagem (Vercel/etc). NUNCA cometa
# um arquivo .env com valores reais no controle de versão.
#
# Rode `npm run env:check` (modo local) ou `npm run validate:env` (modo
# produção) para validar antes de subir o serviço. Veja scripts/validate-env.mjs.

# --- Supabase (obrigatório) ---------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque-a-anon-key-do-supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-do-supabase
# Chave privada (service_role). Nunca exponha ao cliente/navegador.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-do-supabase

# --- Segredos internos (obrigatório, minimo 32 caracteres cada) --------
# Gere cada um com: openssl rand -base64 32
TENANT_CONTEXT_SECRET=
RATE_LIMIT_HASH_SALT=
AUDIT_HASH_SALT=
EMPLOYEE_SESSION_SECRET=
DEVICE_IDENTITY_SECRET=
RECEIPT_TOKEN_SECRET=
INTERNAL_JOBS_SECRET=

# --- URL pública da aplicação --------------------------------------------
# Em produção use a URL HTTPS real (ex.: https://ponto.suaempresa.com.br).
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Bootstrap do primeiro tenant/administrador (opcional, usado só na
#     primeira configuração via /api/admin/bootstrap-master) -------------
MASTER_SETUP_TOKEN=
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_NAME=
MASTER_TENANT_NAME=
MASTER_TENANT_SLUG=
MASTER_TENANT_TIMEZONE=America/Sao_Paulo
PLATFORM_SUPERADMIN_EMAIL=

# --- Integrações opcionais -------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPORTS_BUCKET=exports
DEFAULT_TIMEZONE=America/Sao_Paulo
ATTACHMENT_SCANNER_ENABLED=false
NEXT_PUBLIC_ALLOW_TENANT_COLOR_OVERRIDE=false

# --- Jobs internos / cron --------------------------------------------------
CRON_SECRET=
# "external": um worker/cron externo chama /api/internal/jobs/process.
# "inline": os jobs rodam dentro do próprio processo da aplicação.
JOB_EXECUTION_MODE=external
JOB_WORKER_ID=

# --- Flags sensíveis --------------------------------------------------------
# Mantenha "false" até a homologação legal externa (eSocial/CLT) estar
# concluída. O build falha propositalmente se isto estiver "true" sem
# homologação (ver scripts/validate-env.mjs).
FEATURE_OFFICIAL_PAYROLL=false
