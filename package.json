{
  "name": "nexponto",
  "version": "5.3.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:full": "next build",
    "build:finalize": "next build --experimental-build-mode=generate",
    "build:compile": "next build --experimental-build-mode=compile",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --config vitest.integration.config.ts --configLoader runner",
    "test:e2e": "playwright test",
    "test:load:health": "node scripts/load-test-health.mjs",
    "test:load:clock": "node scripts/load-test-clock.mjs",
    "test:watch": "vitest --configLoader runner",
    "migrations:check": "node scripts/verify-migrations.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security:data": "node scripts/check-sensitive-data.mjs",
    "verify": "npm run security:data && npm run migrations:check && npm run structure:check && npm run structure:v51 && npm run structure:v53 && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:production": "npm run env:check && npm run security:data && npm run migrations:check && npm run structure:check && npm run structure:v51 && npm run structure:v53 && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run audit",
    "structure:check": "node scripts/verify-v4-structure.mjs",
    "structure:v51": "node scripts/verify-v51-remediation.mjs",
    "structure:v53": "node scripts/verify-v53-production.mjs",
    "test:critical": "vitest run src/lib/services/__tests__/hour-bank-v51.test.ts src/lib/services/__tests__/historical-journey-v51.test.ts src/lib/services/__tests__/session-attendance-v51.test.ts src/lib/services/__tests__/schedule-v51.test.ts src/lib/services/__tests__/professional-payroll-v51.test.ts --configLoader runner"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.55.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.21",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/qrcode": "^1.5.5",
    "@playwright/test": "1.62.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.32.0",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.19",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "sharp": "0.35.0",
    "uuid": "11.1.1",
    "postcss": "$postcss"
  }
}
